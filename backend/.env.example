# Application
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DBNAME>?retryWrites=true&w=majority

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=15m

# Shared secret for /internal routes; must match admin-backend, payment-service and notification-service
INTERNAL_SERVICE_TOKEN=change-me-use-openssl-rand-hex-32

RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Standalone Payment Service Integration
PAYMENT_SERVICE_URL=http://127.0.0.1:5002
PAYMENT_SERVICE_TIMEOUT_MS=5000

NOTIFICATION_SERVICE_URL=http://127.0.0.1:5003
NOTIFICATION_SERVICE_TIMEOUT_MS=5000

AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

METRICS_COLLECTOR_ENABLED=false

# Optional — defaults shown where the code has one
LOG_LEVEL=info
SCHEDULER_ENABLED=true
TRUST_PROXY_HOPS=1
APP_VERSION=local
RATE_LIMIT_GENERAL_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_PAYMENT_MAX=
RATE_LIMIT_EMERGENCY_MAX=
CLOUDWATCH_EMF_ENABLED=false
CLOUDWATCH_METRICS_NAMESPACE=HomeEase

# Used only by `npm run seed:admin`
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

