# ============================================================
# HomeEase Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Application
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string — backend (booking-service) owns its own
# database now (homeease_booking): users, bookings, professionals, services,
# emergencyrequests, slotreservations. Payments and notifications live in
# their own services' databases.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DBNAME>?retryWrites=true&w=majority

# JWT — use a strong random secret: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Razorpay (Managed by Payment Service; optional fallback here for public key distribution)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Standalone Payment Service Integration
PAYMENT_SERVICE_URL=http://127.0.0.1:5002
PAYMENT_SERVICE_TIMEOUT_MS=5000

# Standalone Notification Service Integration — booking-confirmed/completed
# emails are dispatched over HTTP now; Gmail SMTP config (EMAIL_USER/EMAIL_PASS/
# EMAIL_FROM) moved to notification-service/.env.example, which owns delivery.
NOTIFICATION_SERVICE_URL=http://127.0.0.1:5003
NOTIFICATION_SERVICE_TIMEOUT_MS=5000

# Azure Blob Storage (Entra ID / DefaultAzureCredential preferred in production)
AZURE_STORAGE_ACCOUNT_NAME=
# Optional local fallback key (not required when using Entra ID / az login / Managed Identity)
AZURE_STORAGE_ACCOUNT_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting (optional overrides)
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_PAYMENT_MAX=20
# RATE_LIMIT_GENERAL_MAX=100

# Metrics collector — polls MongoDB every 30 seconds to refresh DB-truth gauges
# (total bookings, active professionals, total revenue, etc.).
# Should ONLY be set to "true" on exactly one replica or a dedicated deployment.
# Running it across multiple replicas causes redundant DB polling and duplicate metric series.
METRICS_COLLECTOR_ENABLED=false

