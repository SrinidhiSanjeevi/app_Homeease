# Payment Service Configuration
PORT=5002
PAYMENT_SERVICE_PORT=5002
NODE_ENV=development
LOG_LEVEL=info

# Database — payment-service owns only its own database now (homeease_payment),
# holding only the `payments` collection. Bookings/users/professionals live in
# booking-service's own database and are reached over HTTP — see
# BOOKING_SERVICE_URL below.
MONGO_URI=mongodb://127.0.0.1:27017/homeease_payment

# Razorpay Credentials (required for payment order creation & verification)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Booking Service Integration (bookings now live only in booking-service —
# payment-service calls its internal API instead of reading/writing
# Booking.status / Booking.paymentStatus directly)
BOOKING_SERVICE_URL=http://127.0.0.1:5000
BOOKING_SERVICE_TIMEOUT_MS=5000

# Shared secret with booking-service's internal API
# (must match booking-service's INTERNAL_SERVICE_TOKEN exactly)
INTERNAL_SERVICE_TOKEN=
