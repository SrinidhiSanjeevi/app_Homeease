# ============================================================
# HomeEase Admin Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Application
PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string — admin-backend owns its own database now
# (homeease_admin), holding only the `auditlogs` collection. Everything else
# (users, bookings, professionals, services, emergencies) lives in
# booking-service's own database and is reached over HTTP — see
# BOOKING_SERVICE_URL below.
MONGO_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DBNAME>?retryWrites=true&w=majority

# JWT — must match backend JWT_SECRET exactly
JWT_SECRET=change-me-use-openssl-rand-hex-32

# Azure Blob Storage (Entra ID / DefaultAzureCredential preferred in production)
AZURE_STORAGE_ACCOUNT_NAME=
# Optional local fallback key (not required when using Entra ID / az login / Managed Identity)
AZURE_STORAGE_ACCOUNT_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Booking Service Integration (users/bookings/professionals/services/emergencies
# now live only in booking-service — admin-backend calls its internal API)
BOOKING_SERVICE_URL=http://127.0.0.1:5000
BOOKING_SERVICE_TIMEOUT_MS=5000

# Shared secret with booking-service's internal admin API
# (must match booking-service's INTERNAL_SERVICE_TOKEN exactly)
INTERNAL_SERVICE_TOKEN=
