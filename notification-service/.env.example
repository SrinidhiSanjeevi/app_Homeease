# Notification Service Configuration
PORT=5003
NOTIFICATION_SERVICE_PORT=5003
NODE_ENV=development
LOG_LEVEL=info

MONGO_URI=mongodb://127.0.0.1:27017/homeease_notification

BOOKING_SERVICE_URL=http://127.0.0.1:5000
BOOKING_SERVICE_TIMEOUT_MS=5000

INTERNAL_SERVICE_TOKEN=

EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=HomeEase <your-sender@gmail.com>

SCHEDULER_ENABLED=true

ALLOWED_ORIGINS=http://localhost:5173
# Optional: comma-separated BCC list, and the address used when a booking has no provider email
NOTIFICATION_BCC=
PROVIDER_FALLBACK_EMAIL=
