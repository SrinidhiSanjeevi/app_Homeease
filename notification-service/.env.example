# Notification Service Configuration
PORT=5003
NOTIFICATION_SERVICE_PORT=5003
NODE_ENV=development
LOG_LEVEL=info

# Database — notification-service owns only its own database now
# (homeease_notification), holding only the `notifications` collection.
# Bookings/users live in booking-service's own database and are reached
# over HTTP — see BOOKING_SERVICE_URL below.
MONGO_URI=mongodb://127.0.0.1:27017/homeease_notification

# Booking Service Integration (bookings/users now live only in
# booking-service — notification-service calls its internal API instead of
# reading Booking/User directly)
BOOKING_SERVICE_URL=http://127.0.0.1:5000
BOOKING_SERVICE_TIMEOUT_MS=5000

# Shared secret with booking-service's internal API
# (must match booking-service's INTERNAL_SERVICE_TOKEN exactly)
INTERNAL_SERVICE_TOKEN=

# Gmail SMTP (Nodemailer) — moved from backend/.env.example. Optional/soft:
# when unset, emails are simulated/logged only (see services/emailProvider.js).
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=HomeEase <your-sender@gmail.com>

# Outbox retry-sweep scheduler — set to "false" to disable (e.g. on a
# short-lived replica or during tests).
SCHEDULER_ENABLED=true
